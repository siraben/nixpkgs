diff --git a/newlib/libc/sys/mmixware/getprogname.c b/newlib/libc/sys/mmixware/getprogname.c
new file mode 100644
--- /dev/null
+++ b/newlib/libc/sys/mmixware/getprogname.c
@@ -0,0 +1,24 @@
+/* getprogname stub for MMIX */
+#include <stdlib.h>
+
+/* Global variable to store program name */
+static const char *__progname = "mmix-program";
+
+const char *
+getprogname (void)
+{
+  return __progname;
+}
+
+void
+setprogname (const char *name)
+{
+  __progname = name;
+}
+
+/* getexecname stub - some systems use this instead */
+const char *
+getexecname (void)
+{
+  return __progname;
+}
diff --git a/newlib/libc/sys/mmixware/getrlimit.c b/newlib/libc/sys/mmixware/getrlimit.c
new file mode 100644
--- /dev/null
+++ b/newlib/libc/sys/mmixware/getrlimit.c
@@ -0,0 +1,69 @@
+/* getrlimit stub for MMIX */
+#include <sys/resource.h>
+#include <errno.h>
+#include <limits.h>
+
+int
+getrlimit (int resource, struct rlimit *rlp)
+{
+  if (rlp == NULL)
+    {
+      errno = EFAULT;
+      return -1;
+    }
+
+  /* Provide reasonable defaults for embedded system */
+  switch (resource)
+    {
+    case RLIMIT_NOFILE:
+      /* Maximum number of open file descriptors */
+      rlp->rlim_cur = 256;
+      rlp->rlim_max = 256;
+      break;
+
+    case RLIMIT_STACK:
+      /* Stack size - provide a reasonable default */
+      rlp->rlim_cur = 1024 * 1024;  /* 1 MB */
+      rlp->rlim_max = 1024 * 1024;
+      break;
+
+    case RLIMIT_DATA:
+    case RLIMIT_AS:
+      /* Data segment and address space */
+      rlp->rlim_cur = RLIM_INFINITY;
+      rlp->rlim_max = RLIM_INFINITY;
+      break;
+
+    case RLIMIT_CORE:
+      /* Core file size - typically disabled on embedded systems */
+      rlp->rlim_cur = 0;
+      rlp->rlim_max = 0;
+      break;
+
+    case RLIMIT_CPU:
+      /* CPU time limit */
+      rlp->rlim_cur = RLIM_INFINITY;
+      rlp->rlim_max = RLIM_INFINITY;
+      break;
+
+    case RLIMIT_FSIZE:
+      /* File size limit */
+      rlp->rlim_cur = RLIM_INFINITY;
+      rlp->rlim_max = RLIM_INFINITY;
+      break;
+
+    default:
+      errno = EINVAL;
+      return -1;
+    }
+
+  return 0;
+}
+
+int
+setrlimit (int resource, const struct rlimit *rlp)
+{
+  /* On embedded systems, we typically don't allow changing limits */
+  errno = EPERM;
+  return -1;
+}
