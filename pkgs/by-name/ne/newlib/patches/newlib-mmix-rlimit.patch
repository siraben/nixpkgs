diff --git a/newlib/libc/include/sys/resource.h b/newlib/libc/include/sys/resource.h
--- a/newlib/libc/include/sys/resource.h
+++ b/newlib/libc/include/sys/resource.h
@@ -20,8 +20,31 @@ struct rusage {
 
