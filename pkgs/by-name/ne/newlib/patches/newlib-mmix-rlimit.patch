+/* Resource limit definitions */
+typedef unsigned long rlim_t;
+
+#define RLIM_INFINITY	(~((rlim_t)0))
+#define RLIM_SAVED_CUR	RLIM_INFINITY
+#define RLIM_SAVED_MAX	RLIM_INFINITY
+
+struct rlimit {
+	rlim_t	rlim_cur;	/* current (soft) limit */
+	rlim_t	rlim_max;	/* maximum value for rlim_cur */
+};
+
+/* Resource limit types */
+#define RLIMIT_CORE	0	/* max core file size */
+#define RLIMIT_CPU	1	/* max cpu time in seconds */
+#define RLIMIT_DATA	2	/* max data segment size */
+#define RLIMIT_FSIZE	3	/* max file size */
+#define RLIMIT_NOFILE	4	/* max number of open files */
+#define RLIMIT_STACK	5	/* max stack size */
+#define RLIMIT_AS	6	/* address space (virtual memory) limit */
+
+int	getrlimit (int, struct rlimit *);
+int	setrlimit (int, const struct rlimit *);
+
 #ifdef __cplusplus
 }
 #endif
 #endif /* !_SYS_RESOURCE_H_ */
