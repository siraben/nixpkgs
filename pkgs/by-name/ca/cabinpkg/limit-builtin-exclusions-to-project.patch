+fn path_under_any_builtin_name(path: &Path, root: &Path) -> bool {
+    path.strip_prefix(root)
+        .unwrap_or(path)
+        .ancestors()
+        .any(|ancestor| {
+            ancestor
+                .file_name()
+                .and_then(|n| n.to_str())
+                .is_some_and(|n| BUILTIN_EXCLUDED_DIR_NAMES.contains(&n))
+        })
