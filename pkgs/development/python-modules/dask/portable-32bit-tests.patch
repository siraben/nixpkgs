-    assert_eq(df.memory_usage(index=False), pdf.memory_usage(index=False))
+    # Memory counts may be widened from intp to int64 by the reduction.
+    assert_eq(df.memory_usage(index=False), pdf.memory_usage(index=False), check_dtype=False)
     assert_eq(df.x.memory_usage(), pdf.x.memory_usage())
